# agpeer Docker Compose example (one-binary container), Unraid layout.
#
# Uses absolute /mnt/user/appdata paths so it works from any location —
# including the Compose Manager plugin, whose project dir lives on the flash
# drive (/boot). Relative ./ paths would silently land there, which is both
# permission-broken and the wrong place for a media library.
#
# One-time setup on Unraid:
#   mkdir -p /mnt/user/appdata/agpeer/downloads
#   mkdir -p /mnt/user/appdata/agpeer/library
#   cp deploy/config.example.toml /mnt/user/appdata/agpeer/config.toml
#   # fill in Soulseek credentials, then:
#   chmod 644 /mnt/user/appdata/agpeer/config.toml
#   chown -R 65534:65534 /mnt/user/appdata/agpeer/downloads /mnt/user/appdata/agpeer/library
#
# The WebUI + API are served from http://<host>:41000.

services:
  agpeer:
    image: ghcr.io/scarlet-raine/agpeer:latest
    container_name: agpeer
    restart: unless-stopped
    ports:
      # WebUI + REST API (bind to a private interface / firewall this port;
      # it carries the API bearer token).
      - "127.0.0.1:41000:41000"
      # Torrent inbound peer port (needed for healthy swarms). Pick a free
      # high port and keep it in sync with [torrent].listen_port in config.
      - "51234:51234"
      # Soulseek peer/file connections (optional, needs no inbound).
      # - "2234:2234/tcp"
      # - "2234:2234/udp"
    environment:
      # Bind inside the container; the 41000 host mapping above decides what
      # is reachable from outside.
      AGPEER_HOST: 0.0.0.0
      AGPEER_DATA_DIR: /data
      AGPEER_CONFIG: /etc/agpeer.toml
      # A browser outside the container cannot reach the loopback-only
      # /__agpeer_token bootstrap, so the token is injected into the served
      # page. WIDENING-EXPOSURE SETTING: any client that can reach port 41000
      # can read the API token. Keep the port mapping private.
      AGPEER_UI_TOKEN_INJECT: "1"
      # Soulseek credentials via env overrides (or via the mounted config):
      # AGPEER_SOULSEEK_USERNAME: ""
      # AGPEER_SOULSEEK_PASSWORD: ""
      # AGPEER_SOULSEEK_SERVER_ADDR: vps.slsknet.org:2242
    command: serve
    volumes:
      # The container runs as UID 65534 (nobody). Every mounted path must be
      # accessible to that UID: the config needs to be readable (644), the
      # downloads/library dirs writable (chown 65534:65534).
      - /mnt/user/appdata/agpeer/config.toml:/etc/agpeer.toml:ro
      # Private app state (SQLite DB, API token, logs). A named volume gets
      # correct ownership automatically — keep this one named.
      - agpeer_data:/data
      # Downloads and library must live on the SAME filesystem so completed
      # items organize via an instant rename instead of a cross-drive copy.
      # Both under the same appdata share satisfies that.
      - /mnt/user/appdata/agpeer/downloads:/opt/agpeer/downloads
      - /mnt/user/appdata/agpeer/library:/opt/agpeer/library
      # Soulseek downloads stage here before post-processing; a host path so
      # you can inspect in-flight files from the share.
      - /mnt/user/appdata/agpeer/soulseek-downloads:/opt/agpeer/soulseek-downloads
    tmpfs:
      - /tmp

volumes:
  agpeer_data:
