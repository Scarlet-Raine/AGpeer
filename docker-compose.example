# agpeer Docker Compose example (one-binary container), Unraid layout.
#
# Zero pre-setup: `docker compose up -d` is all it takes. There is no config
# file to place — every deployment-relevant setting comes from the
# environment below (fill in the two Soulseek credential lines first).
# Docker creates the bind-mounted directories on first start and the image's
# entrypoint aligns their ownership with PUID/PGID automatically.
#
# The WebUI + API are served from http://<host>:41000.

services:
  agpeer:
    image: ghcr.io/scarlet-raine/agpeer:latest
    container_name: agpeer
    restart: unless-stopped
    ports:
      # WebUI + REST API, reachable from your LAN. WIDENING-EXPOSURE: the
      # WebUI serves the API token to any client that can reach this port
      # (see AGPEER_UI_TOKEN_INJECT below). For loopback-only access (e.g.
      # behind a reverse proxy on the same host) use "127.0.0.1:41000:41000".
      - "41000:41000"
      # Torrent inbound peer port (needed for healthy swarms). Pick a free
      # high port and keep it in sync with AGPEER_TORRENT_LISTEN_PORT below.
      - "51234:51234"
      # Soulseek peer/file connections (optional, needs no inbound).
      # - "2234:2234/tcp"
      # - "2234:2234/udp"
    environment:
      # Bind inside the container; the port mapping above decides what is
      # reachable from outside.
      AGPEER_HOST: 0.0.0.0
      AGPEER_DATA_DIR: /data
      # Soulseek credentials — the only lines you need to edit.
      AGPEER_SOULSEEK_USERNAME: ""
      AGPEER_SOULSEEK_PASSWORD: ""
      # Run the agpeer process as your user (Unraid defaults: 99/100). The
      # entrypoint aligns ownership of /data and /opt/agpeer/* automatically.
      PUID: 99
      PGID: 100
      # A browser outside the container cannot reach the loopback-only
      # /__agpeer_token bootstrap, so the token is injected into the served
      # page. WIDENING-EXPOSURE SETTING: any client that can reach port 41000
      # can read the API token.
      AGPEER_UI_TOKEN_INJECT: "1"
      # Storage locations, matching the volume mounts below.
      AGPEER_TORRENT_DOWNLOAD_ROOT: /opt/agpeer/downloads
      AGPEER_SOULSEEK_DOWNLOAD_ROOT: /opt/agpeer/soulseek-downloads
      AGPEER_POSTPROCESS_LIBRARY_ROOT: /opt/agpeer/library
      # Backends (defaults are conservative without a config file).
      AGPEER_TORRENT_ENABLED: "true"
      AGPEER_TORRENT_ENGINE: rqbit
      AGPEER_TORRENT_LISTEN_PORT: "51234"
      AGPEER_SOULSEEK_ENABLED: "true"
      AGPEER_HOOK_SEARCH_ENABLED: "true"
      # Optional extras (defaults shown):
      # AGPEER_SOULSEEK_SERVER_ADDR: vps.slsknet.org:2242
      # AGPEER_SOULSEEK_LISTEN_PORT: 2234
      # AGPEER_LOG_FILE_FILTER: debug
      # RUST_LOG: info
    command: serve
    volumes:
      # Private app state (SQLite DB, API token, rqbit DHT cache). A named
      # volume gets correct ownership automatically — keep this one named.
      - agpeer_data:/data
      # Downloads and library must live on the SAME filesystem so completed
      # items organize via an instant rename instead of a cross-drive copy.
      # Both under the same appdata share satisfies that. The directories are
      # created on first start; ownership is fixed by the entrypoint.
      - /mnt/user/appdata/agpeer/downloads:/opt/agpeer/downloads
      - /mnt/user/appdata/agpeer/library:/opt/agpeer/library
      # Soulseek downloads stage here before post-processing; a host path so
      # you can inspect in-flight files from the share.
      - /mnt/user/appdata/agpeer/soulseek-downloads:/opt/agpeer/soulseek-downloads
    tmpfs:
      - /tmp

volumes:
  agpeer_data:
